{
  "name": "@themakers/webmcp-bridge-ext",
  "version": "1.0.0",
  "description": "Native WebMCP tabs to local MCP: a Chrome extension and native host.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/themakers/webmcp-bridge-ext.git" },
  "bin": { "webmcp-bridge-ext": "dist/cli.js" },
  "files": ["dist", "README.md", "SKILL.md", "references", "agents", "LICENSE"],
  "engines": { "node": ">=22" },
  "packageManager": "bun@1.3.0",
  "publishConfig": { "registry": "https://registry.npmjs.org", "access": "public" },
  "scripts": {
    "prebuild": "bun -e 'require(\"fs\").rmSync(\"dist\",{recursive:true,force:true})'",
    "build": "bun scripts/build.ts",
    "prepare": "node -e 'if(require(\"fs\").existsSync(\"src/cli.ts\"))require(\"child_process\").execSync(\"bun run build\",{stdio:\"inherit\"})'",
    "check": "bun x --bun tsc --noEmit && bun scripts/check.ts",
    "test": "bun test test/unit.test.ts test/broker.test.ts",
    "test:browser": "bun test test/browser.test.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.17.1",
    "fflate": "0.8.2",
    "sigstore": "^3.1.0",
    "@sinclair/typebox": "0.34.41"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/chrome": "^0.1.0",
    "typescript": "^5.8.3",
    "playwright": "^1.55.1"
  }
}
