{
  "name": "@themakers/pcmbew",
  "version": "0.1.0",
  "description": "An opaque stdio/WebSocket MCP bridge, with the server in your SPA.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/themakers/pcmbew.git" },
  "bin": { "pcmbew": "./dist/cli.cjs" },
  "exports": { ".": { "types": "./dist/client.d.ts", "import": "./dist/client.js", "default": "./dist/client.js" } },
  "types": "./dist/client.d.ts",
  "files": ["dist", "README.md", "SKILL.md", "references", "agents", "examples/pi/index.ts", "examples/pi/package.json", "examples/pi/tsconfig.json", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "packageManager": "bun@1.3.0",
  "publishConfig": { "registry": "https://npm.pkg.github.com", "access": "public" },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --format=cjs --packages=external --outfile=dist/cli.cjs && bun build src/client.ts --target=browser --packages=external --outfile=dist/client.js && bun x --bun tsc --emitDeclarationOnly",
    "check": "bun run docs:check && bun x --bun tsc --noEmit",
    "docs:check": "bun scripts/check-docs.mjs",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  }
}
